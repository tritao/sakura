{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Debug build with the in-process workspace tests enabled",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "asan",
      "displayName": "AddressSanitizer + UBSan",
      "description": "Debug build with AddressSanitizer and UndefinedBehaviorSanitizer",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build-asan",
      "cacheVariables": {
        "SAKURA_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "opt",
      "displayName": "Optimized profiling build",
      "description": "Optimized build with debug symbols and frame pointers for profiling",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-opt",
      "environment": {
        "PATH": "${sourceDir}/.deps/install/bin:$penv{PATH}",
        "PKG_CONFIG_PATH": "${sourceDir}/.deps/install/lib/pkgconfig:$penv{PKG_CONFIG_PATH}"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O2 -g -DNDEBUG -fno-omit-frame-pointer",
        "SAKURA_PROTOBUF_PREFIX": "${sourceDir}/.deps/install",
        "BUILD_TESTING": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "opt",
      "configurePreset": "opt",
      "jobs": 0
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0:halt_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      },
      "filter": {
        "exclude": {
          "name": "ui-smoke"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
