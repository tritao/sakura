#!/usr/bin/env python3
"""Create and initialize a persistent Codex thread through app-server."""

import argparse
import json
import os
import queue
import subprocess
import sys
import threading
import time


def send(process, message):
    process.stdin.write(json.dumps(message, separators=(",", ":")) + "\n")
    process.stdin.flush()


def read_messages(process, messages):
    for line in process.stdout:
        messages.put(line)
    messages.put("")


def receive(process, messages, deadline):
    try:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise TimeoutError("timed out waiting for codex app-server")
        line = messages.get(timeout=remaining)
    except queue.Empty as error:
        raise TimeoutError("timed out waiting for codex app-server") from error
    if not line:
        stderr = process.stderr.read().strip()
        detail = f": {stderr}" if stderr else ""
        raise RuntimeError(f"codex app-server exited unexpectedly{detail}")
    return json.loads(line)


def request(process, messages, request_id, method, params, deadline):
    send(process, {"id": request_id, "method": method, "params": params})
    while True:
        message = receive(process, messages, deadline)
        if message.get("id") != request_id:
            continue
        if "error" in message:
            error = message["error"]
            raise RuntimeError(error.get("message", json.dumps(error)))
        return message.get("result", {})


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--working-directory")
    parser.add_argument("--prompt-file")
    parser.add_argument("--model")
    parser.add_argument("--reasoning")
    parser.add_argument("--session-name")
    parser.add_argument("--thread-id")
    parser.add_argument("--goal-action",
                        choices=("start", "start-if-none", "status", "pause",
                                 "resume", "clear"))
    parser.add_argument("--goal-file")
    parser.add_argument("--title")
    parser.add_argument("--timeout", type=float, default=3600)
    args = parser.parse_args()

    if args.goal_action:
        if not args.thread_id:
            parser.error("--goal-action requires --thread-id")
        if args.goal_action in ("start", "start-if-none") and not args.goal_file:
            parser.error(f"{args.goal_action} requires --goal-file")
    elif not args.working_directory or not args.prompt_file:
        parser.error("thread creation requires --working-directory and --prompt-file")
    codex = os.environ.get("SAKURA_CODEX_BINARY", "codex")
    process = subprocess.Popen(
        [codex, "app-server", "--stdio", "--enable", "goals"],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        bufsize=1,
    )
    messages = queue.Queue()
    reader = threading.Thread(
        target=read_messages, args=(process, messages),
        daemon=True,
    )
    reader.start()
    deadline = time.monotonic() + args.timeout
    thread_id = None
    try:
        request(process, messages, 1, "initialize", {
            "clientInfo": {"name": "sakura", "title": "Sakura", "version": "1"}
        }, deadline)
        send(process, {"method": "initialized"})
        if args.goal_action:
            goal_params = {"threadId": args.thread_id}
            action = args.goal_action
            if action == "status":
                result = request(process, messages, 2, "thread/goal/get",
                                 goal_params, deadline)
            elif action == "clear":
                request(process, messages, 2, "thread/goal/clear",
                        goal_params, deadline)
                result = {"goal": None, "cleared": True}
            else:
                next_id = 2
                if action == "start-if-none":
                    current = request(process, messages, next_id,
                                      "thread/goal/get", goal_params, deadline)
                    next_id += 1
                    if current.get("goal") is not None:
                        result = current
                        result["reused"] = True
                        print(json.dumps({"title": args.title, **result},
                                         separators=(",", ":")))
                        return 0
                if action in ("start", "start-if-none"):
                    goal_params["objective"] = open(
                        args.goal_file, encoding="utf-8").read()
                    goal_params["status"] = "active"
                else:
                    goal_params["status"] = (
                        "paused" if action == "pause" else "active"
                    )
                result = request(process, messages, next_id,
                                 "thread/goal/set", goal_params, deadline)
            print(json.dumps({"title": args.title, **result},
                             separators=(",", ":")))
            return 0
        thread_params = {
            "cwd": args.working_directory,
            "approvalPolicy": "never",
            "sandbox": "danger-full-access",
            "config": {"features": {"hooks": True}},
        }
        if args.model:
            thread_params["model"] = args.model
        started = request(process, messages, 2, "thread/start", thread_params, deadline)
        thread_id = started["thread"]["id"]
        next_id = 3
        if args.session_name:
            request(process, messages, next_id, "thread/name/set", {
                "threadId": thread_id, "name": args.session_name
            }, deadline)
            next_id += 1
        # Sakura submits the prompt after attaching the interactive CLI.  A
        # turn owned by this short-lived app-server would be abandoned when
        # the helper exits.
        print(thread_id)
        return 0
    except (KeyError, OSError, RuntimeError, TimeoutError, json.JSONDecodeError) as error:
        suffix = f" (thread {thread_id})" if thread_id else ""
        print(f"sakura-codex-app-server: {error}{suffix}", file=sys.stderr)
        return 1
    finally:
        if process.poll() is None:
            process.terminate()
            try:
                process.wait(timeout=3)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait()


if __name__ == "__main__":
    raise SystemExit(main())
