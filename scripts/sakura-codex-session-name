#!/usr/bin/env python3
"""Read a persisted Codex session name through the app-server protocol."""

import argparse
import json
import os
import selectors
import subprocess
import sys


def send(process, message):
    process.stdin.write(json.dumps(message) + "\n")
    process.stdin.flush()


def receive_response(process, request_id, timeout=10):
    selector = selectors.DefaultSelector()
    selector.register(process.stdout, selectors.EVENT_READ)
    try:
        while True:
            events = selector.select(timeout)
            if not events:
                raise RuntimeError("timed out waiting for Codex app-server")
            line = process.stdout.readline()
            if not line:
                error = process.stderr.read().strip()
                raise RuntimeError(error or "Codex app-server exited unexpectedly")
            message = json.loads(line)
            if message.get("id") == request_id:
                return message
    finally:
        selector.close()


def read_name(session_id):
    process = subprocess.Popen(
        ["codex", "app-server", "--listen", "stdio://"],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        env=os.environ.copy(),
    )
    try:
        send(process, {
            "method": "initialize",
            "id": 1,
            "params": {
                "clientInfo": {
                    "name": "sakura",
                    "title": "Sakura",
                    "version": "1.0",
                },
            },
        })
        response = receive_response(process, 1)
        if "error" in response:
            raise RuntimeError(response["error"].get("message", "initialize failed"))
        send(process, {"method": "initialized", "params": {}})
        send(process, {
            "method": "thread/read",
            "id": 2,
            "params": {"threadId": session_id, "includeTurns": False},
        })
        response = receive_response(process, 2)
        if "error" in response:
            # Sakura also accepts a Codex session name for resume. Resolve
            # that form through the supported history API before giving up.
            send(process, {
                "method": "thread/list",
                "id": 3,
                "params": {"limit": 100, "searchTerm": session_id},
            })
            response = receive_response(process, 3)
            if "error" in response:
                raise RuntimeError(response["error"].get("message", "thread/list failed"))
            matches = [
                thread for thread in response.get("result", {}).get("data", [])
                if thread.get("name") == session_id
            ]
            if len(matches) != 1:
                return ""
            thread = matches[0]
        else:
            thread = response.get("result", {}).get("thread", {})
        name = thread.get("name")
        if isinstance(name, str):
            return name.strip()
        return ""
    finally:
        process.terminate()
        try:
            process.wait(timeout=2)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--name", required=True, dest="session_id")
    args = parser.parse_args()
    try:
        print(read_name(args.session_id))
    except (OSError, RuntimeError, ValueError, json.JSONDecodeError) as exc:
        print(f"could not read Codex session name: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
