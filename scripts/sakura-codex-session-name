#!/usr/bin/env python3
"""Read persisted Codex session metadata through the app-server protocol."""

import argparse
import base64
import json
import os
import selectors
import subprocess
import sys

HELPER_PROTOCOL_VERSION = "v1"


def send(process, message):
    process.stdin.write(json.dumps(message) + "\n")
    process.stdin.flush()


def receive_response(process, request_id, timeout=10):
    selector = selectors.DefaultSelector()
    selector.register(process.stdout, selectors.EVENT_READ)
    try:
        while True:
            events = selector.select(timeout)
            if not events:
                raise RuntimeError("timed out waiting for Codex app-server")
            line = process.stdout.readline()
            if not line:
                error = process.stderr.read().strip()
                raise RuntimeError(error or "Codex app-server exited unexpectedly")
            message = json.loads(line)
            if message.get("id") == request_id:
                return message
    finally:
        selector.close()


class CodexAppServer:
    """Keep one app-server connection open for Sakura session operations."""

    def __init__(self):
        self.process = None
        self.next_request_id = 1

    def start(self):
        self.process = subprocess.Popen(
            ["codex", "app-server", "--listen", "stdio://"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            env=os.environ.copy(),
        )
        send(self.process, {
            "method": "initialize",
            "id": 1,
            "params": {
                "clientInfo": {
                    "name": "sakura",
                    "title": "Sakura",
                    "version": "1.0",
                },
            },
        })
        response = receive_response(self.process, 1)
        if "error" in response:
            raise RuntimeError(response["error"].get("message", "initialize failed"))
        send(self.process, {"method": "initialized", "params": {}})
        self.next_request_id = 2

    def close(self):
        if self.process is None:
            return
        self.process.terminate()
        try:
            self.process.wait(timeout=2)
        except subprocess.TimeoutExpired:
            self.process.kill()
            self.process.wait()
        self.process = None

    def read_name(self, session_id):
        if self.process is None or self.process.poll() is not None:
            self.close()
            self.start()

        request_id = self.next_request_id
        self.next_request_id += 1
        send(self.process, {
            "method": "thread/read",
            "id": request_id,
            "params": {"threadId": session_id, "includeTurns": False},
        })
        response = receive_response(self.process, request_id)
        if "error" in response:
            # Sakura also accepts a Codex session name for resume. Resolve
            # that form through the supported history API before giving up.
            request_id = self.next_request_id
            self.next_request_id += 1
            send(self.process, {
                "method": "thread/list",
                "id": request_id,
                "params": {"limit": 100, "searchTerm": session_id},
            })
            response = receive_response(self.process, request_id)
            if "error" in response:
                raise RuntimeError(response["error"].get("message", "thread/list failed"))
            matches = [
                thread for thread in response.get("result", {}).get("data", [])
                if thread.get("name") == session_id
            ]
            if len(matches) != 1:
                return ""
            thread = matches[0]
        else:
            thread = response.get("result", {}).get("thread", {})
        name = thread.get("name")
        if isinstance(name, str):
            return name.strip()
        return ""

    def read_cwd(self, session_id):
        thread = self._read_thread(session_id)
        cwd = thread.get("cwd")
        if not isinstance(cwd, str):
            return ""
        return cwd.strip()

    def read_info(self, session_id):
        thread = self._read_thread(session_id)
        name = thread.get("name")
        cwd = thread.get("cwd")
        return (
            name.strip() if isinstance(name, str) else "",
            cwd.strip() if isinstance(cwd, str) else "",
        )

    def _read_thread(self, session_id):
        if self.process is None or self.process.poll() is not None:
            self.close()
            self.start()

        request_id = self.next_request_id
        self.next_request_id += 1
        send(self.process, {
            "method": "thread/read",
            "id": request_id,
            "params": {"threadId": session_id, "includeTurns": False},
        })
        response = receive_response(self.process, request_id)
        if "error" in response:
            request_id = self.next_request_id
            self.next_request_id += 1
            send(self.process, {
                "method": "thread/list",
                "id": request_id,
                "params": {"limit": 100, "searchTerm": session_id},
            })
            response = receive_response(self.process, request_id)
            if "error" in response:
                raise RuntimeError(response["error"].get("message", "thread/list failed"))
            matches = [
                thread for thread in response.get("result", {}).get("data", [])
                if thread.get("name") == session_id
            ]
            if len(matches) != 1:
                raise RuntimeError(f"could not resolve Codex session {session_id!r}")
            return matches[0]
        return response.get("result", {}).get("thread", {})

    def set_name(self, session_id, name):
        thread = self._read_thread(session_id)
        thread_id = thread.get("id")
        if not isinstance(thread_id, str) or not thread_id:
            raise RuntimeError("Codex app-server returned a thread without an ID")

        request_id = self.next_request_id
        self.next_request_id += 1
        send(self.process, {
            "method": "thread/name/set",
            "id": request_id,
            "params": {"threadId": thread_id, "name": name},
        })
        response = receive_response(self.process, request_id)
        if "error" in response:
            raise RuntimeError(response["error"].get("message", "thread/name/set failed"))


def read_name(session_id):
    server = CodexAppServer()
    try:
        return server.read_name(session_id)
    finally:
        server.close()


def read_cwd(session_id):
    server = CodexAppServer()
    try:
        return server.read_cwd(session_id)
    finally:
        server.close()


def set_name(session_id, name):
    server = CodexAppServer()
    try:
        server.set_name(session_id, name)
    finally:
        server.close()


def encode(value):
    return base64.b64encode(value.encode("utf-8")).decode("ascii")


def decode(value):
    return base64.b64decode(value.encode("ascii"), validate=True).decode("utf-8")


def run_server():
    server = CodexAppServer()
    try:
        for line in sys.stdin:
            fields = line.rstrip("\n").split("\t")
            versioned = False
            if len(fields) == 2:
                request_id, encoded_session_id = fields
                operation = "name"
            elif len(fields) == 3 and fields[1] in ("cwd", "info"):
                request_id, operation, encoded_session_id = fields
            elif (len(fields) == 4 and fields[1] == HELPER_PROTOCOL_VERSION and
                  fields[2] == "info"):
                request_id, _version, operation, encoded_session_id = fields
                versioned = True
            elif (len(fields) == 5 and fields[1] == HELPER_PROTOCOL_VERSION and
                  fields[2] == "set-name"):
                request_id, _version, operation, encoded_session_id, encoded_name = fields
                versioned = True
            else:
                continue
            try:
                session_id = decode(encoded_session_id)
                if operation == "cwd":
                    response = f"{request_id}\tok\t{encode(server.read_cwd(session_id))}\n"
                elif operation == "info":
                    name, cwd = server.read_info(session_id)
                    if versioned:
                        response = (f"{request_id}\t{HELPER_PROTOCOL_VERSION}\tok\t"
                                    f"{encode(name)}\t{encode(cwd)}\n")
                    else:
                        response = (f"{request_id}\tok\t{encode(name)}\t"
                                    f"{encode(cwd)}\n")
                elif operation == "set-name":
                    server.set_name(session_id, decode(encoded_name))
                    response = (f"{request_id}\t{HELPER_PROTOCOL_VERSION}\tok\t"
                                f"{encode('')}\n")
                else:
                    response = f"{request_id}\tok\t{encode(server.read_name(session_id))}\n"
            except (OSError, RuntimeError, ValueError, json.JSONDecodeError) as exc:
                server.close()
                if versioned:
                    response = (f"{request_id}\t{HELPER_PROTOCOL_VERSION}\terror\t"
                                f"{encode(str(exc))}\n")
                else:
                    response = f"{request_id}\terror\t{encode(str(exc))}\n"
            sys.stdout.write(response)
            sys.stdout.flush()
    finally:
        server.close()


def main():
    parser = argparse.ArgumentParser()
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--name", dest="session_id")
    mode.add_argument("--cwd", dest="cwd_session_id")
    mode.add_argument("--set-name", nargs=2, metavar=("SESSION", "NAME"),
                      dest="set_name")
    mode.add_argument("--server", action="store_true")
    args = parser.parse_args()
    if args.server:
        run_server()
        return 0
    if args.set_name:
        try:
            set_name(*args.set_name)
        except (OSError, RuntimeError, ValueError, json.JSONDecodeError) as exc:
            print(f"could not set Codex session name: {exc}", file=sys.stderr)
            return 1
        return 0
    if args.cwd_session_id:
        try:
            print(read_cwd(args.cwd_session_id))
        except (OSError, RuntimeError, ValueError, json.JSONDecodeError) as exc:
            print(f"could not read Codex session working directory: {exc}",
                  file=sys.stderr)
            return 1
        return 0
    try:
        print(read_name(args.session_id))
    except (OSError, RuntimeError, ValueError, json.JSONDecodeError) as exc:
        print(f"could not read Codex session name: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
